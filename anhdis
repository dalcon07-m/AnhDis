def sha256_file(path):
    digest = hashlib.sha256()
    with Path(path).open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _read_json_status(path, expected_stage):
    path = Path(path)
    if not path.is_file():
        return None, f"[MISSING] {path.name}"
    try:
        data = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        return None, f"[ERROR] {path.name}: {exc}"
    accepted = {expected_stage} if isinstance(expected_stage, str) else set(expected_stage)
    if data.get("stage") not in accepted:
        return None, f"[ERROR] {path.name}: unexpected stage {data.get('stage')!r}"
    return data, None


def manifest_single_point_software(manifest):
    software = str(manifest.get("single_point_software", "gaussian")).strip().lower()
    if software not in {"gaussian", "orca"}:
        raise ValueError(f"Invalid single-point software in a2 manifest: {software!r}")
    return software


def output_terminated_normally(text, software):
    if software == "gaussian":
        return "Normal termination of Gaussian" in text and "Error termination" not in text
    return (
        "ORCA TERMINATED NORMALLY" in text
        and "ORCA finished by error termination" not in text
    )


def manifest_output_path(scan_root, record):
    if record.get("output"):
        return Path(scan_root) / record["output"]
    return (Path(scan_root) / record["input"]).with_suffix(".log")


def workflow_status(active, config_path):
    """Inspect workflow manifests and files without modifying the calculation."""
    project_root = Path(config_path).resolve().parent
    scan_root = Path(active.SCAN_ROOT).resolve()
    lines = ["AnhDis workflow integrity check", f"Scan root: {scan_root}"]
    scan, problem = _read_json_status(
        scan_root / "scan_manifest.json", "curvilinear_scan_geometries_with_mass_coordinate"
    )
    if problem:
        lines.append(problem)
        lines.append("Next action: run a1 (without --update for a new scan directory).")
        return lines

    scan_points = scan.get("energy_points", [])
    missing_xyz = [point.get("xyz", "<undefined>") for point in scan_points
                   if not (scan_root / point.get("xyz", "")).is_file()]
    log_path = opt_freq_output(active)
    log_mismatch = (
        log_path.is_file()
        and scan.get("source_log_sha256") != sha256_file(log_path)
    )
    configured_software = opt_freq_software(active)
    software_mismatch = (
        configured_software != "auto"
        and scan.get("opt_freq_software") not in {None, configured_software}
    )
    configured_coordinate = str(getattr(active, "A1_COORDINATE_SYSTEM", "curvilinear"))
    scan_coordinate = str(scan.get("coordinate_system", "curvilinear"))
    if missing_xyz:
        lines.append(f"[ERROR] a1 manifest: {len(missing_xyz)} geometry files are missing")
    elif log_mismatch:
        lines.append("[STALE] a1 manifest: configured optimization/frequency output has changed")
    elif software_mismatch:
        lines.append(
            "[STALE] a1 manifest: configured optimization/frequency software differs "
            "from the scan"
        )
    elif configured_coordinate != scan_coordinate:
        lines.append(
            f"[STALE] a1 manifest: scan is {scan_coordinate}, config requests {configured_coordinate}"
        )
    else:
        lines.append(
            f"[OK] a1: {len(scan_points)} geometries for modes "
            f"{compact_modes(scan.get('selected_modes', []))}"
        )

    inputs, problem = _read_json_status(
        scan_root / "input_manifest.json",
        {"anhdis_single_point_inputs", "curvilinear_gaussian_single_point_inputs"},
    )
    inputs_stale = False
    scan_hash_stale = False
    header_stale = False
    input_errors = []
    if problem:
        lines.append(problem)
    else:
        current_scan_hash = sha256_file(scan_root / "scan_manifest.json")
        if inputs.get("scan_manifest_sha256") != current_scan_hash:
            inputs_stale = True
            scan_hash_stale = True
            lines.append("[STALE] a2 manifest: it belongs to an earlier a1 scan")
        manifest_software = manifest_single_point_software(inputs)
        configured_point_software = resolved_single_point_software(active, scan)
        if configured_point_software != manifest_software:
            inputs_stale = True
            header_stale = True
            lines.append(
                f"[STALE] a2 manifest uses {manifest_software.upper()}, but config requests "
                f"{configured_point_software.upper()}"
            )
        header_path = single_point_header(active, configured_point_software)
        if header_path.is_file() and inputs.get("header_sha256") != sha256_file(header_path):
            inputs_stale = True
            header_stale = True
            lines.append(
                f"[STALE] a2 manifest: the configured {configured_point_software.upper()} "
                "header has changed"
            )
        records = inputs.get("points", [])
        if inputs.get("input_count") != len(records):
            input_errors.append("input_count does not match the point list")
        for record in records:
            xyz = scan_root / record.get("xyz", "")
            com = scan_root / record.get("input", "")
            if not xyz.is_file() or not com.is_file():
                input_errors.append(f"missing {record.get('xyz') or record.get('input')}")
                continue
            if record.get("xyz_sha256") != sha256_file(xyz):
                input_errors.append(f"changed geometry {record.get('xyz')}")
            if record.get("input_sha256") != sha256_file(com):
                input_errors.append(f"changed input {record.get('input')}")
        if input_errors:
            lines.append(f"[ERROR] a2 manifest: {len(input_errors)} integrity problems")
            for detail in input_errors[:5]:
                lines.append(f"        {detail}")
            if len(input_errors) > 5:
                lines.append(f"        ... and {len(input_errors) - 5} more")
        elif not inputs_stale:
            lines.append(
                f"[OK] a2: {len(records)} {manifest_software.upper()} inputs match "
                "the current a1 scan"
            )

    output_counts = {"normal": 0, "missing": 0, "failed": 0, "wrong_identity": 0}
    if inputs is not None and not inputs_stale and not input_errors:
        manifest_software = manifest_single_point_software(inputs)
        for record in inputs.get("points", []):
            output = manifest_output_path(scan_root, record)
            if not output.is_file():
                output_counts["missing"] += 1
                continue
            text = output.read_text(errors="replace")
            if not output_terminated_normally(text, manifest_software):
                output_counts["failed"] += 1
            elif (
                record.get("job_tag")
                and re.sub(r"\s+", "", record["job_tag"])
                not in re.sub(r"\s+", "", text)
            ):
                output_counts["wrong_identity"] += 1
            else:
                output_counts["normal"] += 1
        total = sum(output_counts.values())
        lines.append(
            "[{}] {} outputs: {normal}/{total} valid; {missing} missing; "
            "{failed} failed; {wrong_identity} wrong identity".format(
                "OK" if output_counts["normal"] == total else "INCOMPLETE",
                manifest_software.upper(), total=total, **output_counts,
            )
        )

    status_path = scan_root / getattr(active, "CALCULATION_STATUS_FILE", "calculation_status.tsv")
    if status_path.is_file():
        try:
            with status_path.open(newline="") as handle:
                rows = list(csv.DictReader(handle, delimiter="\t"))
            counts = {}
            for row in rows:
                key = row.get("status", "UNKNOWN")
                counts[key] = counts.get(key, 0) + 1
            rendered = ", ".join(f"{key}={value}" for key, value in sorted(counts.items()))
            lines.append(f"[{'OK' if set(counts) <= {'OK'} else 'CHECK'}] a4 status: {rendered}")
        except (OSError, csv.Error) as exc:
            lines.append(f"[ERROR] a4 status table: {exc}")

    fit, fit_problem = _read_json_status(
        scan_root / "fit_metadata.json", "curvilinear_potential_fit_in_constant_mass_coordinate"
    )
    if fit_problem:
        lines.append(fit_problem)
    else:
        fit_modes = [int(mode) for mode in fit.get("selected_modes", [])]
        missing_modes = sorted(set(scan.get("selected_modes", [])) - set(fit_modes))
        label = "OK" if not missing_modes else "INCOMPLETE"
        detail = "" if not missing_modes else f"; missing modes {compact_modes(missing_modes)}"
        lines.append(f"[{label}] a5: fitted modes {compact_modes(fit_modes)}{detail}")

    quantum, quantum_problem = _read_json_status(
        scan_root / "a6_metadata.json", "curvilinear_quantum_thermal_distribution"
    )
    if quantum_problem:
        lines.append(quantum_problem)
    else:
        quantum_modes = [int(mode) for mode in quantum.get("selected_modes", [])]
        temperature = float(quantum.get("temperature_K", float("nan")))
        current_temperature = float(getattr(active, "TEMP", temperature))
        temperature_matches = math.isclose(temperature, current_temperature, rel_tol=0.0, abs_tol=1.0e-12)
        label = "OK" if temperature_matches else "STALE"
        lines.append(
            f"[{label}] a6: modes {compact_modes(quantum_modes)}, T={temperature:g} K"
            + ("" if temperature_matches else f" (config requests {current_temperature:g} K)")
        )

    ensemble_root = Path(getattr(active, "ENSEMBLE_ROOT", project_root / "ensemble_output")).resolve()
    ensemble_name = getattr(active, "A7_MANIFEST_FILE", "a7_manifest.json")
    ensemble, ensemble_problem = _read_json_status(
        ensemble_root / ensemble_name, "curvilinear_internal_coordinate_ensemble"
    )
    if ensemble_problem:
        lines.append(f"[MISSING] a7 ensemble manifest in {ensemble_root}")
    else:
        lines.append(
            f"[OK] a7: {ensemble.get('n_samples')} samples, seed "
            f"{ensemble.get('random_seed')}, modes {compact_modes(ensemble.get('selected_modes', []))}"
        )

    if inputs is None:
        next_action = "run a2"
    elif header_stale:
        next_action = (
            "restore the original single-point program/header or use a new SCAN_ROOT; use a2 --force "
            "only if no result files exist"
        )
    elif scan_hash_stale:
        next_action = "run a2-update (it preserves valid existing single-point results)"
    elif input_errors:
        next_action = "inspect the listed a2 integrity errors before submitting anything"
    elif output_counts["missing"]:
        next_action = "run a3-dry, then submit"
    elif output_counts["failed"] or output_counts["wrong_identity"]:
        next_action = "run a4, inspect failures, then resubmit deliberately"
    elif fit is None:
        next_action = "run a4-strict, then a5"
    elif quantum is None:
        next_action = "run a6"
    elif ensemble is None:
        next_action = "run a7 (or a7-pbs for parallel reconstruction)"
    else:
        next_action = "workflow products are present; inspect any CHECK/STALE line above"
    lines.append(f"Next action: {next_action}.")
    return lines


def _same_numeric_grid(first, second):
    first = [round(float(value), 12) for value in first]
    second = [round(float(value), 12) for value in second]
    return first == second


def _configured_grid_for_mode(active, mode):
    return list(getattr(active, "Q_ENERGY_ANG_BY_MODE", {}).get(mode, active.Q_ENERGY_ANG))


def modes_needing_a1_update(active):
    """Return only modes whose configured grid extends the current a1 manifest."""
    root = Path(active.SCAN_ROOT).resolve()
    scan, problem = _read_json_status(
        root / "scan_manifest.json", "curvilinear_scan_geometries_with_mass_coordinate"
    )
    if problem:
        raise FileNotFoundError(f"a1 --update requires a valid scan manifest in {root}.")
    selected = list(getattr(active, "SELECTED_MODES", [])) or list(range(1, int(scan["n_modes"]) + 1))
    if any(mode < 1 or mode > int(scan["n_modes"]) for mode in selected):
        raise ValueError(f"Configured modes must lie between 1 and {scan['n_modes']}.")
    previous_by_mode = {
        int(mode): list(grid) for mode, grid in scan.get("Q_energy_angstrom_by_mode", {}).items()
    }
    changed = []
    for mode in selected:
        requested = _configured_grid_for_mode(active, mode)
        previous = previous_by_mode.get(mode)
        if previous is None:
            changed.append(mode)
            continue
        if _same_numeric_grid(previous, requested):
            continue
        previous_set = {round(float(value), 12) for value in previous}
        requested_set = {round(float(value), 12) for value in requested}
        if not previous_set <= requested_set:
            removed = sorted(previous_set - requested_set)
            raise ValueError(
                f"Mode {mode}: the configured Q grid removes existing values {removed}. "
                "Safe update only extends a grid; use a new SCAN_ROOT to shrink or replace it."
            )
        changed.append(mode)
    return changed


def modes_needing_a2_update(active):
    """Return modes whose a1 point set is not yet represented by input_manifest.json."""
    root = Path(active.SCAN_ROOT).resolve()
    scan, problem = _read_json_status(
        root / "scan_manifest.json", "curvilinear_scan_geometries_with_mass_coordinate"
    )
    if problem:
        raise FileNotFoundError(f"a2 --update requires a valid scan manifest in {root}.")
    inputs, problem = _read_json_status(
        root / "input_manifest.json",
        {"anhdis_single_point_inputs", "curvilinear_gaussian_single_point_inputs"},
    )
    if problem:
        raise FileNotFoundError("No valid a2 manifest exists; run normal a2 first.")
    scan_q = {}
    input_q = {}
    for point in scan.get("energy_points", []):
        scan_q.setdefault(int(point["mode"]), set()).add(round(float(point["Q_angstrom"]), 12))
    for point in inputs.get("points", []):
        input_q.setdefault(int(point["mode"]), set()).add(round(float(point["Q_angstrom"]), 12))
    return sorted(mode for mode, values in scan_q.items() if input_q.get(mode, set()) != values)


def write_parallel_pbs(
    stage, active, project_root, modes=None, node=None, workers=None,
    output=None, ensemble=None, coordinates=None,
):
    """Create a PBS file with the active interpreter, worker count, and node choice."""
    definitions = {
        "a1-pbs": ("a1", "a1_geometries.py", int(getattr(active, "A1_WORKERS", 1)), []),
        "a1-update-pbs": (
            "a1_update", "a1_geometries.py", int(getattr(active, "A1_WORKERS", 1)), ["--update"]
        ),
        "a7-pbs": ("a7", "a7_coord_therm.py", int(getattr(active, "A7_WORKERS", 1)), []),
    }
    if stage not in definitions:
        raise ValueError(f"No parallel PBS definition for {stage}.")
    label, script_name, configured_workers, extra = definitions[stage]
    workers = configured_workers if workers is None else int(workers)
    if workers < 1:
        raise ValueError(f"{label} worker count must be positive.")
    node = normalized_parallel_node(
        getattr(active, "ANHDIS_PARALLEL_NODE", "auto") if node is None else node
    )
    node_request = "1" if node == "auto" else node
    node_cpus = getattr(active, "NODE_CPUS", {}).get(node)
    if node_cpus is not None and workers > int(node_cpus):
        raise ValueError(f"{node} provides {node_cpus} CPUs, fewer than the requested {workers}.")
    command = ["python3", "-u", f"./{script_name}", "--workers", str(workers), *extra]
    if stage == "a7-pbs":
        command.extend(["--ensemble", ensemble or "both", "--coordinates", coordinates or "scan"])
    if modes:
        command.extend(["--modes", *(str(mode) for mode in modes)])
    if output is not None:
        command.extend(["--output", str(Path(output).resolve())])
    login_command = "python3 --version && " + shlex.join(command)
    filename = project_root / f"run_{label}_parallel.pbs"
    content = "\n".join((
        "#!/bin/bash",
        f"#PBS -N anhdis_{label}",
        f"#PBS -l nodes={node_request}:ppn={workers}",
        "#PBS -l mem=8gb",
        "#PBS -l walltime=12:00:00",
        "#PBS -S /bin/bash",
        "#PBS -j oe",
        f"#PBS -o {label}_parallel.out",
        "#PBS -V",
        "",
        'cd "$PBS_O_WORKDIR" || exit 1',
        "export OMP_NUM_THREADS=1",
        "export OPENBLAS_NUM_THREADS=1",
        "export MKL_NUM_THREADS=1",
        "export NUMEXPR_NUM_THREADS=1",
        "",
        "/bin/bash -lc " + shlex.quote(login_command),
        "",
    ))
    filename.write_text(content)
    filename.chmod(0o750)
    return filename


def stage_commands(active, project_root):
    python = sys.executable
    workers = str(int(getattr(active, "A1_WORKERS", 1)))
    a7_workers = str(int(getattr(active, "A7_WORKERS", 1)))
    return {
        "a1": [python, "-u", str(project_root / "a1_geometries.py"), "--workers", workers],
        "a1-update": [python, "-u", str(project_root / "a1_geometries.py"), "--workers", workers, "--update"],
        "a2": [python, str(project_root / "a2_gaussian_input_generator.py")],
        "a2-update": [python, str(project_root / "a2_gaussian_input_generator.py"), "--update"],
        "a3-dry": [python, str(project_root / "a3_lanzador.py")],
        "submit": [python, str(project_root / "a3_lanzador.py"), "--submit"],
        "resubmit": [python, str(project_root / "a3_lanzador.py"), "--submit", "--resubmit"],
        "a4": [python, str(project_root / "a4_check_calculation.py")],
        "a4-strict": [python, str(project_root / "a4_check_calculation.py"), "--strict"],
        "a5": [python, str(project_root / "a5_fitting.py")],
        "a6": [python, str(project_root / "a6_probdis_therm.py")],
        "a7": [python, "-u", str(project_root / "a7_coord_therm.py"), "--workers", a7_workers],
    }


def run_stage(
    stage, active, config_path, assume_yes=False, node_override=None,
    workers_override=None, output_override=None, ensemble_override=None, coordinates_override=None,
):
    project_root = Path(config_path).resolve().parent
    commands = stage_commands(active, project_root)
    pbs_stages = {"a1-pbs", "a1-update-pbs", "a7-pbs"}
    if (ensemble_override is not None or coordinates_override is not None) and stage not in {"a7", "a7-pbs"}:
        raise ValueError("--ensemble and --coordinates are used only with a7 or a7-pbs.")
    if workers_override is not None and int(workers_override) < 1:
        raise ValueError("--workers must be a positive integer.")
    if output_override is not None and stage not in {"a7", "a7-pbs"}:
        raise ValueError("--output is used only with a7 or a7-pbs.")
    if output_override is not None:
        output_override = resolved_project_path(output_override, project_root)
        if unavailable_a7_output(output_override):
            raise FileExistsError(
                f"Use a new or empty a7 output directory: {output_override}"
            )
    if stage in {"a1", "a1-pbs"}:
        scan_manifest = Path(active.SCAN_ROOT).resolve() / "scan_manifest.json"
        if scan_manifest.is_file():
            changed_modes = modes_needing_a1_update(active)
            if not changed_modes:
                print(
                    "The existing a1 manifest already matches the configured Q grids; "
                    "there is nothing to regenerate."
                )
                return 0
            stage = "a1-update-pbs" if stage == "a1-pbs" else "a1-update"
            print(
                "Existing a1 scan detected. Switching automatically to a safe "
                f"--update for modes: {compact_modes(changed_modes)}"
            )
    if stage == "a2":
        scan_path = Path(active.SCAN_ROOT).resolve() / "scan_manifest.json"
        input_path = scan_path.with_name("input_manifest.json")
        if scan_path.is_file() and input_path.is_file():
            try:
                current_scan = json.loads(scan_path.read_text())
                previous_inputs = json.loads(input_path.read_text())
            except json.JSONDecodeError:
                current_scan = {}
                previous_inputs = {}
            point_software = resolved_single_point_software(active, current_scan)
            header_path = single_point_header(active, point_software).resolve()
            scan_changed = previous_inputs.get("scan_manifest_sha256") != sha256_file(scan_path)
            header_unchanged = (
                header_path.is_file()
                and previous_inputs.get("header_sha256") == sha256_file(header_path)
                and manifest_single_point_software(previous_inputs) == point_software
            )
            if scan_changed and header_unchanged:
                print("The a1 manifest was extended; switching normal a2 to safe a2-update.")
                stage = "a2-update"
    if stage not in commands and stage not in pbs_stages:
        raise ValueError(f"Unknown workflow stage: {stage}.")
    if node_override is not None and stage not in pbs_stages:
        raise ValueError("--node is used only with a1-pbs, a1-update-pbs, or a7-pbs.")
    worker_setting = (
        int(workers_override) if workers_override is not None
        else int(getattr(active, "A1_WORKERS", 1)) if stage in {"a1", "a1-update"}
        else int(getattr(active, "A7_WORKERS", 1)) if stage == "a7"
        else 1
    )
    if stage in {"a1", "a1-update", "a7"} and worker_setting > 1:
        host = socket.gethostname().lower()
        if "master" in host or "login" in host:
            print(f"Refusing to start parallel {stage} on a login/master host.")
            print(f"Choose {stage}-pbs, or run it inside an allocated compute node.")
            return 2
    update_modes = None
    if stage in {"a1-update", "a1-update-pbs"}:
        update_modes = modes_needing_a1_update(active)
        if not update_modes:
            print("No configured Q grid extends the existing a1 scan; nothing to update.")
            return 0
        print(f"a1 safe update will process only modes: {compact_modes(update_modes)}")
    elif stage == "a2-update":
        update_modes = modes_needing_a2_update(active)
        if not update_modes:
            print("The a2 manifest already covers every current a1 point; nothing to update.")
            return 0
        print(f"a2 safe update will process only modes: {compact_modes(update_modes)}")

    if stage in pbs_stages | {"submit", "resubmit"} and not assume_yes:
        description = {
            "a1-pbs": "submit the parallel a1 PBS job",
            "a1-update-pbs": "submit the parallel safe-update a1 PBS job",
            "a7-pbs": "submit the parallel a7 PBS job",
            "submit": "submit pending single-point calculations",
            "resubmit": "resubmit calculations even when log files exist",
        }[stage]
        if not ask_yes_no(f"Really {description}", False):
            print("Cancelled.")
            return 0
    if stage in pbs_stages:
        pbs_path = write_parallel_pbs(
            stage, active, project_root, update_modes,
            node=node_override, workers=workers_override,
            output=output_override,
            ensemble=ensemble_override, coordinates=coordinates_override,
        )
        command = [str(getattr(active, "SUBMIT_COMMAND", "qsub")), str(pbs_path)]
        required_file = pbs_path
        print(f"PBS script generated from the active configuration: {pbs_path.name}")
    else:
        command = list(commands[stage])
        if stage == "a7":
            command.extend(["--ensemble", ensemble_override or "both",
                            "--coordinates", coordinates_override or "scan"])
        if workers_override is not None and stage in {"a1", "a1-update", "a7"}:
            worker_index = command.index("--workers") + 1
            command[worker_index] = str(int(workers_override))
        if update_modes:
            command.extend(["--modes", *(str(mode) for mode in update_modes)])
        if output_override is not None:
            command.extend(["--output", str(output_override)])
        script_indices = {"a1": 2, "a1-update": 2, "a7": 2}
        required_file = Path(command[script_indices.get(stage, 1)])
    if not required_file.is_file():
        raise FileNotFoundError(f"Required file not found: {required_file}")
    print("Running:", " ".join(command))
    result = subprocess.run(command, cwd=project_root, check=False)
    print(f"Stage {stage} finished with exit code {result.returncode}.")
    if result.returncode == 0 and stage in {"a1-update", "a1-update-pbs"}:
        print("After a1 finishes successfully, run: ./anhdis --run a2-update")
    elif result.returncode == 0 and stage == "a2-update":
        print("Next: ./anhdis --run a3-dry, then submit only the new pending points.")
    return result.returncode


STAGE_MENU = (
    ("a1", "Generate a1 scan geometries (directly or on a compute node)"),
    ("a1-update", "Safely extend an a1 scan (directly or on a compute node)"),
    ("a2", "Generate Gaussian/ORCA inputs"),
    ("a2-update", "Update inputs after extending an a1 scan"),
    ("a3-dry", "Preview single-point submissions"),
    ("submit", "Submit pending single-point calculations"),
    ("resubmit", "Resubmit single-point calculations"),
    ("a4", "Check Gaussian/ORCA calculations"),
    ("a4-strict", "Strictly validate completed calculations"),
    ("a5", "Build/fit potentials"),
    ("a6", "Calculate position and momentum distributions"),
    ("a7", "Generate nuclear ensembles (directly or on a compute node)"),
)

CLI_STAGE_NAMES = tuple(item[0] for item in STAGE_MENU) + (
    "a1-pbs", "a1-update-pbs", "a7-pbs",
)


def choose_stage_execution(stage, active, input_function=input):
    """Ask how a1/a7 should run and return stage, node, and worker overrides."""
    if stage not in {"a1", "a1-update", "a7"}:
        return stage, None, None
    default_workers = int(getattr(
        active, "A7_WORKERS" if stage == "a7" else "A1_WORKERS", 1,
    ))
    method = ask_choice(
        "Execution", ("compute-node", "direct"), "compute-node", input_function,
    )
    workers = ask_number(
        "Worker processes", default_workers, int, 1, input_function,
    )
    if method == "direct":
        return stage, None, workers
    while True:
        try:
            node = normalized_parallel_node(ask_text(
                "Compute node (auto lets PBS choose)",
                getattr(active, "ANHDIS_PARALLEL_NODE", "auto"), input_function,
            ))
            break
        except ValueError as exc:
            print(exc)
    pbs_stage = {"a1": "a1-pbs", "a1-update": "a1-update-pbs", "a7": "a7-pbs"}[stage]
    print(
        f"Selected: {pbs_stage}, node={node}, workers={workers}. "
        "These choices apply only to this submission."
    )
    return pbs_stage, node, workers


def stage_menu(active, config_path, input_function=input):
    print("\nWorkflow stages")
    for index, (_, description) in enumerate(STAGE_MENU, 1):
        print(f"  {index:2d}. {description}")
    print("   0. Back")
    answer = input_function("Select stage: ").strip()
    if answer in {"", "0"}:
        return
    try:
        stage = STAGE_MENU[int(answer) - 1][0]
    except (ValueError, IndexError):
        print("Invalid stage.")
        return
    ensemble, coordinates = None, None
    if stage == "a7":
        print("Curvilinear harmonic output also includes a Cartesian harmonic reference. "
              "Anharmonic coordinates must match the computed PES.")
        ensemble = ask_choice("Distribution", ("thermal_harmonic", "thermal_anharmonic", "both"),
                              "both", input_function)
        coordinates = ask_choice("Geometry coordinates", ("cartesian", "curvilinear", "scan"),
                                "scan", input_function)
    stage, node, workers = choose_stage_execution(stage, active, input_function)
    output = (
        choose_a7_output_if_needed(active, config_path, input_function)
        if stage in {"a7", "a7-pbs"} else None
    )
    run_stage(
        stage, active, config_path,
        node_override=node, workers_override=workers, output_override=output,
        ensemble_override=ensemble, coordinates_override=coordinates,
    )


