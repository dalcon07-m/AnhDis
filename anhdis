def show_timing_summary(active, config_path, recent=12):
    """Print per-stage totals and the most recent recorded executions."""
    project_root = Path(config_path).resolve().parent
    path = Path(getattr(
        active, "EXECUTION_TIMING_FILE", project_root / "anhdis_execution_times.tsv",
    )).resolve()
    if not path.is_file():
        print(f"No execution timings have been recorded yet: {path}")
        return
    with path.open(newline="") as stream:
        rows = list(csv.DictReader(stream, delimiter="\t"))
    valid = []
    for row in rows:
        try:
            row["_elapsed"] = float(row["elapsed_seconds"])
        except (KeyError, TypeError, ValueError):
            continue
        valid.append(row)
    if not valid:
        print(f"The timing file has no valid records: {path}")
        return
    grouped = {}
    for row in valid:
        grouped.setdefault(row["stage"], []).append(row)
    print(f"\nExecution-time summary: {path}")
    print("stage  runs  ok  failed       total         mean          max")
    for stage in sorted(grouped):
        records = grouped[stage]
        durations = [row["_elapsed"] for row in records]
        okay = sum(row.get("status") == "OK" for row in records)
        failed = len(records) - okay
        print(
            f"{stage:<6} {len(records):>4} {okay:>3} {failed:>7}  "
            f"{format_elapsed_time(sum(durations)):>11}  "
            f"{format_elapsed_time(sum(durations) / len(durations)):>11}  "
            f"{format_elapsed_time(max(durations)):>11}"
        )
    print(f"\nMost recent {min(recent, len(valid))} executions:")
    for row in valid[-recent:]:
        print(
            f"  {row.get('finished_at', '')}  {row.get('stage', ''):<3}  "
            f"{row.get('status', ''):<6}  {row.get('elapsed_hms', ''):>12}  "
            f"{row.get('hostname', '')}"
        )


def interactive_menu(config_path):
    while True:
        print("\nMain menu")
        print("  1. Configure calculation")
        print("  2. Configure limits and fits by mode")
        print("  3. Show active configuration")
        print("  4. Check manifests and workflow files")
        print("  5. Run or submit a workflow stage")
        print("  6. Show normal command order")
        print("  7. Show execution-time summary")
        print("  0. Exit")
        answer = input("Select option: ").strip()
        if answer == "1":
            configure(config_path)
        elif answer == "2":
            configure_mode_settings(config_path)
        elif answer == "3":
            print("\n" + "\n".join(configuration_summary(load_config(config_path), config_path)))
        elif answer == "4":
            print("\n" + "\n".join(workflow_status(load_config(config_path), config_path)))
        elif answer == "5":
            stage_menu(load_config(config_path), config_path)
        elif answer == "6":
            show_commands(load_config(config_path))
        elif answer == "7":
            show_timing_summary(load_config(config_path), config_path)
        elif answer in {"0", ""}:
            return 0
        else:
            print("Invalid option.")


def main():
    default_config = Path(__file__).resolve().parent / "config.py"
    parser = argparse.ArgumentParser(description="Interactive setup and launcher for AnhDis.")
    parser.add_argument("--config", type=Path, default=default_config)
    action = parser.add_mutually_exclusive_group()
    action.add_argument("--configure", action="store_true", help="Run the setup wizard")
    action.add_argument("--configure-modes", action="store_true", help="Configure scan limits and fits by mode")
    action.add_argument("--show", action="store_true", help="Show the active configuration")
    action.add_argument("--check", action="store_true", help="Check manifests and workflow files")
    action.add_argument("--timings", action="store_true", help="Show execution-time history")
    action.add_argument("--run", choices=CLI_STAGE_NAMES, help="Run one stage")
    parser.add_argument("--yes", action="store_true", help="Confirm a requested submission")
    parser.add_argument(
        "--node", help="PBS node for this run only, e.g. qcexnod56; does not change config.py",
    )
    parser.add_argument(
        "--workers", type=int,
        help="Worker processes for this a1/a7 run only; does not change config.py",
    )
    parser.add_argument(
        "--output", type=Path,
        help="New/empty output directory for this a7 run only; does not change config.py",
    )
    parser.add_argument("--ensemble", choices=("thermal_harmonic", "thermal_anharmonic", "both"),
                        help="a7 distributions for this run only")
    parser.add_argument("--coordinates", choices=("cartesian", "curvilinear", "scan"),
                        help="a7 geometry reconstruction for this run only")
    args = parser.parse_args()
    config_path = args.config.resolve()
    if not config_path.is_file():
        raise FileNotFoundError(f"config.py not found: {config_path}")
    print_banner()
    migration_backup = migrate_legacy_config_file(config_path)
    if migration_backup is not None:
        print("Migrated legacy end-of-file overrides into the original config.py assignments.")
        print(f"Pre-migration backup: {migration_backup}")
    if args.configure:
        configure(config_path)
        return 0
    if args.configure_modes:
        configure_mode_settings(config_path)
        return 0
    active = load_config(config_path)
    if args.show:
        print("\n".join(configuration_summary(active, config_path)))
        return 0
    if args.check:
        print("\n".join(workflow_status(active, config_path)))
        return 0
    if args.timings:
        show_timing_summary(active, config_path)
        return 0
    if args.run:
        output_override = args.output
        if args.run in {"a7", "a7-pbs"} and output_override is None:
            output_override = choose_a7_output_if_needed(active, config_path)
        return run_stage(
            args.run, active, config_path, args.yes,
            node_override=args.node, workers_override=args.workers,
            output_override=output_override,
            ensemble_override=args.ensemble, coordinates_override=args.coordinates,
        )
    return interactive_menu(config_path)


if __name__ == "__main__":
    raise SystemExit(main())
