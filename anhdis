def load_config(config_path):
    """Load config.py from source, never from a potentially stale .pyc file."""
    config_path = Path(config_path).resolve()
    module = types.ModuleType("_anhdis_active_config")
    module.__file__ = str(config_path)
    module.__package__ = None
    source = config_path.read_bytes()
    exec(compile(source, str(config_path), "exec"), module.__dict__)
    return module


def display_path(value, project_root):
    path = Path(value)
    try:
        return str(path.resolve().relative_to(Path(project_root).resolve()))
    except ValueError:
        return str(path)


def opt_freq_output(active):
    """Return the new generic source path, with legacy-config compatibility."""
    value = getattr(active, "OPT_FREQ_OUTPUT", None)
    if value is None:
        value = getattr(active, "GAUSSIAN_LOG", None)
    if value is None:
        raise ValueError("Define OPT_FREQ_OUTPUT (or legacy GAUSSIAN_LOG) in config.py.")
    return Path(value)


def opt_freq_software(active):
    """Return the configured Gaussian/ORCA selector."""
    value = str(getattr(active, "OPT_FREQ_SOFTWARE", "auto")).strip().lower()
    if value not in {"auto", "gaussian", "orca"}:
        raise ValueError("OPT_FREQ_SOFTWARE must be auto, gaussian, or orca.")
    return value


def single_point_software(active):
    """Return the configured a2--a5 Gaussian/ORCA selector."""
    value = str(getattr(active, "SINGLE_POINT_SOFTWARE", "gaussian")).strip().lower()
    if value not in {"auto", "gaussian", "orca"}:
        raise ValueError("SINGLE_POINT_SOFTWARE must be auto, gaussian, or orca.")
    return value


def resolved_single_point_software(active, scan=None):
    """Resolve the a2 backend, using a1 metadata when the setting is auto."""
    value = single_point_software(active)
    if value == "auto":
        if scan is not None:
            value = str(scan.get("opt_freq_software", "")).strip().lower()
        if value not in {"gaussian", "orca"}:
            source = opt_freq_software(active)
            if source in {"gaussian", "orca"}:
                value = source
    if value not in {"gaussian", "orca"}:
        raise ValueError(
            "Cannot resolve SINGLE_POINT_SOFTWARE=auto before a1; select gaussian or orca."
        )
    return value


def single_point_header(active, software):
    """Return the template associated with a resolved a2 backend."""
    if software == "gaussian":
        return Path(active.GAUSSIAN_HEADER)
    return Path(getattr(active, "ORCA_HEADER", Path(active.PROJECT_ROOT) / "orca_head.inp"))


def path_expression(value, project_root):
    """Represent a path relative to PROJECT_ROOT whenever possible."""
    raw = os.path.expandvars(os.path.expanduser(str(value).strip()))
    path = Path(raw)
    if not path.is_absolute():
        return f"PROJECT_ROOT / {str(path)!r}"
    try:
        relative = path.resolve().relative_to(Path(project_root).resolve())
    except ValueError:
        return f"Path({str(path)!r})"
    return f"PROJECT_ROOT / {str(relative)!r}"


def resolved_project_path(value, project_root):
    """Resolve an interactive path relative to the calculation directory."""
    raw = os.path.expandvars(os.path.expanduser(str(value).strip()))
    path = Path(raw)
    return path.resolve() if path.is_absolute() else (Path(project_root) / path).resolve()


def unavailable_a7_output(path):
    """Return True when a7 would refuse to use this output path."""
    path = Path(path)
    return path.exists() and (not path.is_dir() or any(path.iterdir()))


def next_a7_output_path(path):
    """Suggest the first unused/empty run-suffixed ensemble directory."""
    path = Path(path).resolve()
    index = 2
    while True:
        candidate = path.with_name(f"{path.name}_run{index}")
        if not unavailable_a7_output(candidate):
            return candidate
        index += 1


def choose_a7_output_if_needed(active, config_path, input_function=input):
    """Prompt for a new a7 directory only when the configured one is occupied."""
    project_root = Path(config_path).resolve().parent
    configured = Path(active.ENSEMBLE_ROOT).resolve()
    if not unavailable_a7_output(configured):
        return None
    print(f"The configured a7 output is not empty: {configured}")
    suggestion = next_a7_output_path(configured)
    while True:
        answer = ask_text(
            "New a7 output directory",
            display_path(suggestion, project_root),
            input_function,
        )
        candidate = resolved_project_path(answer, project_root)
        if unavailable_a7_output(candidate):
            print(f"That path is also nonempty: {candidate}")
            suggestion = next_a7_output_path(candidate)
            continue
        print(f"This a7 run will write to: {candidate}")
        return candidate


def parse_modes(text):
    """Parse 'all', blank, or values/ranges such as '1-5 8 11'."""
    text = str(text).strip().lower().replace(",", " ")
    if not text or text == "all":
        return []
    modes = set()
    for token in text.split():
        if "-" in token:
            pieces = token.split("-")
            if len(pieces) != 2:
                raise ValueError(f"Invalid mode range: {token!r}.")
            first, last = (int(item) for item in pieces)
            if first < 1 or last < first:
                raise ValueError(f"Invalid mode range: {token!r}.")
            modes.update(range(first, last + 1))
        else:
            mode = int(token)
            if mode < 1:
                raise ValueError("Mode numbers must be positive.")
            modes.add(mode)
    return sorted(modes)


def parse_nodes(text):
    values = parse_modes(text)
    if not values:
        raise ValueError("At least one cluster node number is required.")
    return values


def compact_modes(modes):
    """Format sorted mode numbers as compact ranges such as 1-4,7,10-12."""
    values = sorted(set(int(mode) for mode in modes))
    if not values:
        return "none"
    ranges = []
    first = previous = values[0]
    for value in values[1:]:
        if value == previous + 1:
            previous = value
            continue
        ranges.append(str(first) if first == previous else f"{first}-{previous}")
        first = previous = value
    ranges.append(str(first) if first == previous else f"{first}-{previous}")
    return ",".join(ranges)


def validate_q_grid(q_min, q_max, step):
    q_min, q_max, step = float(q_min), float(q_max), float(step)
    if not all(math.isfinite(value) for value in (q_min, q_max, step)):
        raise ValueError("The Q-grid values must be finite.")
    if step <= 0.0 or q_max <= q_min:
        raise ValueError("Q_max must exceed Q_min and the step must be positive.")
    n_steps = int(round((q_max - q_min) / step))
    if n_steps < 1 or abs(q_min + n_steps * step - q_max) > 1.0e-10:
        raise ValueError("Q_min and Q_max must be separated by an integer number of steps.")
    zero_index = int(round(-q_min / step))
    if zero_index < 0 or zero_index > n_steps or abs(q_min + zero_index * step) > 1.0e-10:
        raise ValueError("The Q grid must contain Q=0 exactly.")
    return q_min, q_max, step


def normalize_temperature(value):
    temperature = float(value)
    if not math.isfinite(temperature) or temperature < 0.0:
        raise ValueError("Temperature must be finite and non-negative.")
    return ZERO_TEMPERATURE_K if temperature == 0.0 else temperature


def _assignment_expressions(text):
    """Return top-level assignment RHS source and exact character spans."""
    tree = ast.parse(text or "\n")
    line_offsets = []
    offset = 0
    for line in text.splitlines(keepends=True):
        line_offsets.append(offset)
        offset += len(line)
    if not line_offsets:
        line_offsets.append(0)
    assignments = {}
    for node in tree.body:
        if not isinstance(node, (ast.Assign, ast.AnnAssign)):
            continue
        targets = node.targets if isinstance(node, ast.Assign) else [node.target]
        names = [target.id for target in targets if isinstance(target, ast.Name)]
        if len(names) != 1:
            continue
        name = names[0]
        start = line_offsets[node.lineno - 1] + node.col_offset
        end = line_offsets[node.end_lineno - 1] + node.end_col_offset
        rhs = ast.get_source_segment(text, node.value)
        assignments.setdefault(name, []).append((start, end, rhs))
    return assignments


def _replace_config_expressions(text, expressions):
    """Replace original config assignments in place, preserving nearby comments."""
    spans = _assignment_expressions(text)
    replacements = []
    missing = []
    for name, rhs in expressions.items():
        occurrences = spans.get(name, [])
        if len(occurrences) > 1:
            raise ValueError(f"config.py defines {name} more than once.")
        if not occurrences:
            missing.append((name, rhs))
            continue
        start, end, _ = occurrences[0]
        replacements.append((start, end, f"{name} = {rhs}"))
    for start, end, replacement in sorted(replacements, reverse=True):
        text = text[:start] + replacement + text[end:]
    if missing:
        anchor = "# ============================================================================\n# ADVANCED SETTINGS"
        position = text.find(anchor)
        if position < 0:
            raise ValueError(
                "config.py lacks required assignments and the USER/ADVANCED section anchor; "
                "update it from the supplied reference config."
            )
        additions = [
            "# Settings added in the USER SETTINGS section by ./anhdis.",
            *(f"{name} = {rhs}" for name, rhs in missing),
            "",
        ]
        text = text[:position] + "\n".join(additions) + "\n" + text[position:]
    return text


def migrate_legacy_managed_block(text):
    """Move settings from an older end-of-file block into original assignments."""
    has_begin = BEGIN_MARKER in text
    has_end = END_MARKER in text
    if has_begin != has_end:
        raise ValueError("config.py contains an incomplete legacy AnhDis settings block.")
    if not has_begin:
        return text
    prefix, remainder = text.split(BEGIN_MARKER, 1)
    body, suffix = remainder.split(END_MARKER, 1)
    legacy = {
        name: occurrences[-1][2]
        for name, occurrences in _assignment_expressions(body).items()
    }
    base = prefix.rstrip() + "\n" + suffix.lstrip("\n")
    return _replace_config_expressions(base, legacy)


def replace_config_expressions(text, expressions):
    """Migrate legacy overrides, then edit the actual config assignments."""
    return _replace_config_expressions(
        migrate_legacy_managed_block(text), expressions,
    )


def save_config_text(config_path, new_text):
    """Validate and atomically save config.py, retaining a one-file backup."""
    config_path = Path(config_path).resolve()
    backup = config_path.with_name(config_path.name + ".anhdis.bak")
    shutil.copy2(config_path, backup)
    temporary = config_path.with_name(config_path.stem + ".anhdis_tmp.py")
    temporary.write_text(new_text)
    try:
        load_config(temporary)
        os.replace(temporary, config_path)
        # CPython timestamp-based bytecode caches may otherwise retain an old
        # value when (for example) degree 5 is replaced by degree 3 within the
        # same filesystem timestamp tick: both source files have equal size.
        cache_directory = config_path.parent / "__pycache__"
        if cache_directory.is_dir():
            for cached_config in cache_directory.glob(f"{config_path.stem}.*.pyc"):
                try:
                    cached_config.unlink()
                except OSError as exc:
                    raise RuntimeError(
                        f"Updated {config_path}, but could not remove stale Python "
                        f"cache {cached_config}. Remove it before running a5."
                    ) from exc
    finally:
        if temporary.exists():
            temporary.unlink()
    return backup


def update_config_assignments(config_path, assignments):
    text = Path(config_path).read_text()
    new_text = replace_config_expressions(
        text, {name: repr(value) for name, value in assignments.items()},
    )
    return save_config_text(config_path, new_text)


def migrate_legacy_config_file(config_path):
    """Remove the old end override block on first use of the new launcher."""
    config_path = Path(config_path).resolve()
    text = config_path.read_text()
    migrated = migrate_legacy_managed_block(text)
    if migrated == text:
        return None
    return save_config_text(config_path, migrated)


def ask_text(prompt, default, input_function=input):
    answer = input_function(f"{prompt} [{default}]: ").strip()
    return answer if answer else str(default)


def ask_choice(prompt, choices, default, input_function=input):
    labels = ", ".join(f"{number}={name}" for number, name in enumerate(choices, 1))
    while True:
        answer = input_function(f"{prompt} ({labels}) [{default}]: ").strip()
        if not answer:
            return default
        if answer in choices:
            return answer
        try:
            index = int(answer) - 1
        except ValueError:
            index = -1
        if 0 <= index < len(choices):
            return choices[index]
        print("Invalid choice; enter its number or name.")


def ask_number(prompt, default, converter=float, minimum=None, input_function=input):
    while True:
        answer = input_function(f"{prompt} [{default}]: ").strip()
        try:
            value = converter(answer) if answer else converter(default)
        except ValueError:
            print("Invalid numeric value.")
            continue
        if minimum is not None and value < minimum:
            print(f"The value must be at least {minimum}.")
            continue
        return value


def ask_yes_no(prompt, default=True, input_function=input):
    suffix = "Y/n" if default else "y/N"
    while True:
        answer = input_function(f"{prompt} [{suffix}]: ").strip().lower()
        if not answer:
            return default
        if answer in {"y", "yes", "s", "si", "sí"}:
            return True
        if answer in {"n", "no"}:
            return False
        print("Enter yes or no.")


def mode_text(modes):
    return "all" if not modes else " ".join(str(mode) for mode in modes)


def ask_explicit_modes(prompt="Modes (e.g. 1-5 8)", input_function=input):
    while True:
        try:
            modes = parse_modes(input_function(f"{prompt}: ").strip())
            if not modes:
                raise ValueError("Select at least one explicit mode.")
            return modes
        except ValueError as exc:
            print(exc)


def normalized_parallel_node(value):
    node = str(value).strip().lower()
    if node in {"", "auto", "any"}:
        return "auto"
    if re.fullmatch(r"\d+", node):
        node = f"qcexnod{int(node):02d}"
    if not re.fullmatch(r"qcexnod\d{2}", node):
        raise ValueError("Use auto, a node number, or a name such as qcexnod56.")
    return node


def configure(config_path, input_function=input):
    config_path = Path(config_path).resolve()
    active = load_config(config_path)
    project_root = config_path.parent

    print("\nAnhDis calculation setup")
    print("Press Enter to retain the value shown in brackets.\n")

    source_software = ask_choice(
        "Optimization/frequency software", ("auto", "gaussian", "orca"),
        opt_freq_software(active), input_function,
    )
    log_name = ask_text(
        "Optimization/frequency output (.log or .out)",
        display_path(opt_freq_output(active), project_root), input_function,
    )
    if not str(log_name).strip():
        raise ValueError("The optimization/frequency output path cannot be empty.")
    point_software = ask_choice(
        "Single-point software", ("auto", "gaussian", "orca"),
        single_point_software(active), input_function,
    )
    effective_point_software = point_software
    if effective_point_software == "auto" and source_software in {"gaussian", "orca"}:
        effective_point_software = source_software
    gaussian_header_name = display_path(active.GAUSSIAN_HEADER, project_root)
    orca_header_name = display_path(
        getattr(active, "ORCA_HEADER", project_root / "orca_head.inp"), project_root,
    )
    automatic_header = ask_yes_no(
        "Generate the single-point header automatically from the opt/freq output",
        bool(getattr(active, "AUTO_GENERATE_SINGLE_POINT_HEADER", True)),
        input_function,
    )
    if automatic_header:
        source_path = resolved_project_path(log_name, project_root)
        if (
            effective_point_software in {"gaussian", "orca"}
            and source_software in {"gaussian", "orca"}
            and effective_point_software != source_software
        ):
            raise ValueError(
                "An automatic header cannot translate between Gaussian and ORCA. "
                "Choose the same program or answer no and supply a manual template."
            )
        if source_path.is_file() and effective_point_software in {"gaussian", "orca"}:
            destination = resolved_project_path(
                gaussian_header_name if effective_point_software == "gaussian" else orca_header_name,
                project_root,
            )
            generate_single_point_header(source_path, destination, effective_point_software)
            print(f"Generated {effective_point_software.upper()} header: {destination}")
            print("It will be regenerated by a2; inspect it before submitting calculations.")
        else:
            print("The header will be generated by a2 after a1 identifies the source program.")
    elif effective_point_software == "orca":
        orca_header_name = ask_text("ORCA single-point header", orca_header_name, input_function)
    else:
        gaussian_header_name = ask_text("Gaussian single-point header", gaussian_header_name, input_function)
    coordinate_system = ask_choice(
        "Coordinate model", ("curvilinear", "cartesian"),
        str(getattr(active, "A1_COORDINATE_SYSTEM", "curvilinear")), input_function,
    )

    current_modes = list(getattr(active, "SELECTED_MODES", []))
    while True:
        try:
            selected_modes = parse_modes(ask_text(
                "Modes (all, or e.g. 1-5 8 11)", mode_text(current_modes), input_function,
            ))
            break
        except ValueError as exc:
            print(exc)

    current_grid = list(getattr(active, "Q_ENERGY_ANG", [-0.4, 0.4]))
    current_step = current_grid[1] - current_grid[0] if len(current_grid) > 1 else 0.1
    while True:
        q_min = ask_number(
            "Default Q minimum (angstrom)", current_grid[0], float,
            input_function=input_function,
        )
        q_max = ask_number(
            "Default Q maximum (angstrom)", current_grid[-1], float,
            input_function=input_function,
        )
        q_step = ask_number(
            "Default Q step (angstrom)", current_step, float, 1.0e-12,
            input_function,
        )
        try:
            q_min, q_max, q_step = validate_q_grid(q_min, q_max, q_step)
            break
        except ValueError as exc:
            print(exc)

    energy_source = ask_choice(
        "Electronic energy (AUTO follows the single-point method)",
        ("SCF", "MP2", "CCSD", "CCSD(T)", "AUTO"),
        str(getattr(active, "ENERGY_SOURCE", "AUTO")).upper(), input_function,
    )
    fit_model = ask_choice(
        "Default potential model", ("polynomial", "pchip"),
        str(getattr(active, "FIT_MODEL", "polynomial")).lower(), input_function,
    )
    fit_degree = int(getattr(active, "FIT_DEGREE", 4))
    if fit_model == "polynomial":
        while True:
            fit_degree = ask_number(
                "Default polynomial degree (2-6)", fit_degree, int, 2, input_function,
            )
            if fit_degree <= 6:
                break
            print("The current fitter supports polynomial degrees from 2 through 6.")

    entered_temperature = ask_number(
        "Temperature in K (enter 0 for the numerical 0 K limit)",
        getattr(active, "TEMP", 298.15), float, 0.0, input_function,
    )
    temperature = normalize_temperature(entered_temperature)
    if entered_temperature == 0.0:
        print(f"Temperature 0 selected: storing {ZERO_TEMPERATURE_K:g} K.")

    samples = ask_number(
        "Number of geometries per ensemble", getattr(active, "NSAMPLES", 100),
        int, 1, input_function,
    )
    seed = ask_number(
        "Random seed", getattr(active, "A7_RANDOM_SEED", 1), int,
        input_function=input_function,
    )
    workers = ask_number(
        "a1 worker processes", getattr(active, "A1_WORKERS", 1), int, 1,
        input_function,
    )
    a7_workers = ask_number(
        "a7 geometry-reconstruction processes", getattr(active, "A7_WORKERS", 1),
        int, 1, input_function,
    )
    while True:
        try:
            parallel_node = normalized_parallel_node(ask_text(
                "Compute node for parallel a1/a7 (auto or qcexnodNN)",
                getattr(active, "ANHDIS_PARALLEL_NODE", "auto"), input_function,
            ))
            break
        except ValueError as exc:
            print(exc)

    previous_coordinate = str(getattr(active, "A1_COORDINATE_SYSTEM", "curvilinear"))
    default_scan = display_path(active.SCAN_ROOT, project_root)
    default_ensemble = display_path(active.ENSEMBLE_ROOT, project_root)
    if coordinate_system != previous_coordinate:
        default_scan = f"{coordinate_system}_scans"
        default_ensemble = f"ensemble_{coordinate_system}"
    scan_root = ask_text("Scan directory", default_scan, input_function)
    ensemble_root = ask_text("Ensemble output directory", default_ensemble, input_function)

    current_nodes = list(getattr(active, "ALLOWED_NODE_NUMS", [1]))
    while True:
        try:
            nodes = parse_nodes(ask_text(
                "Allowed single-point node numbers", mode_text(current_nodes), input_function,
            ))
            break
        except ValueError as exc:
            print(exc)
    pbs_ppn = ask_number(
        "CPU cores per single-point job", getattr(active, "PBS_PPN", 2), int, 1,
        input_function,
    )
    reset_specific = ask_yes_no(
        "Reset molecule-specific scan and fit overrides", True, input_function,
    )

    expressions = {
        "OPT_FREQ_SOFTWARE": repr(source_software),
        "OPT_FREQ_OUTPUT": path_expression(log_name, project_root),
        "GAUSSIAN_LOG": "OPT_FREQ_OUTPUT",
        "SINGLE_POINT_SOFTWARE": repr(point_software),
        "AUTO_GENERATE_SINGLE_POINT_HEADER": repr(automatic_header),
        "GAUSSIAN_HEADER": path_expression(gaussian_header_name, project_root),
        "ORCA_HEADER": path_expression(orca_header_name, project_root),
        "SCAN_ROOT": path_expression(scan_root, project_root),
        "SELECTED_MODES": repr(selected_modes),
        "A1_COORDINATE_SYSTEM": repr(coordinate_system),
        "Q_ENERGY_ANG": f"make_q_grid({q_min!r}, {q_max!r}, {q_step!r})",
        "ENERGY_SOURCE": repr(energy_source),
        "FIT_MODEL": repr(fit_model),
        "FIT_DEGREE": repr(fit_degree),
        "TEMP": repr(temperature),
        "NSAMPLES": repr(samples),
        "A7_RANDOM_SEED": repr(seed),
        "ENSEMBLE_ROOT": path_expression(ensemble_root, project_root),
        "A1_WORKERS": repr(workers),
        "A7_WORKERS": repr(a7_workers),
        "ANHDIS_PARALLEL_NODE": repr(parallel_node),
        "PBS_PPN": repr(pbs_ppn),
        "ALLOWED_NODE_NUMS": repr(nodes),
        "ALLOWED_NODES": '[f"qcexnod{number:02d}" for number in ALLOWED_NODE_NUMS]',
    }
    for name in MODE_DICTIONARY_NAMES:
        value = {} if reset_specific else dict(getattr(active, name, {}))
        expressions[name] = repr(value)
    new_text = replace_config_expressions(config_path.read_text(), expressions)

    backup = save_config_text(config_path, new_text)

    print("\nConfiguration saved successfully.")
    print(f"Active config: {config_path}")
    print(f"Backup:       {backup}")
    print("Run ./anhdis again and choose a workflow stage.")
    print("The original assignments inside config.py were updated in place.")
    print("For advanced changes, edit those settings directly in config.py.")


def _regular_grid_description(values):
    values = [float(value) for value in values]
    if not values:
        return "empty"
    if len(values) == 1:
        return f"{values[0]:g} A (1 point)"
    steps = [values[index + 1] - values[index] for index in range(len(values) - 1)]
    if max(steps) - min(steps) <= 1.0e-10:
        return f"{values[0]:g}:{values[-1]:g}:{steps[0]:g} A ({len(values)} points)"
    return f"{values[0]:g} to {values[-1]:g} A ({len(values)} irregular points)"


def mode_specific_lines(active):
    """Return a compact, human-readable description of per-mode overrides."""
    q_overrides = dict(getattr(active, "Q_ENERGY_ANG_BY_MODE", {}))
    model_overrides = dict(getattr(active, "FIT_MODEL_BY_MODE", {}))
    degree_overrides = dict(getattr(active, "FIT_DEGREE_BY_MODE", {}))
    range_overrides = dict(getattr(active, "FIT_Q_RANGE_ANG_BY_MODE", {}))
    cubic_overrides = dict(getattr(active, "FIT_MAX_CUBIC_FACTOR_BY_MODE", {}))
    all_overrides = {
        name: dict(getattr(active, name, {})) for name in MODE_DICTIONARY_NAMES
    }
    modes = sorted({int(mode) for values in all_overrides.values() for mode in values})
    lines = ["Mode-specific settings:"]
    if not modes:
        lines.append("  none (all modes use the defaults above)")
        return lines
    for mode in modes:
        pieces = []
        if mode in q_overrides:
            pieces.append("Q=" + _regular_grid_description(q_overrides[mode]))
        model = str(model_overrides.get(mode, getattr(active, "FIT_MODEL", "polynomial"))).lower()
        if mode in model_overrides or mode in degree_overrides:
            if model == "polynomial":
                degree = int(degree_overrides.get(mode, getattr(active, "FIT_DEGREE", 4)))
                pieces.append(f"fit=polynomial degree {degree}")
            else:
                pieces.append("fit=PCHIP")
        if mode in range_overrides:
            q_min, q_max = range_overrides[mode]
            pieces.append(f"fit-Q=[{float(q_min):g},{float(q_max):g}] A")
        if mode in cubic_overrides:
            factor = cubic_overrides[mode]
            description = "disabled" if factor is None else f"factor {float(factor):g}"
            if model == "pchip":
                description += " (ignored by PCHIP)"
            pieces.append(f"cubic-limit={description}")
        lines.append(f"  mode {mode}: " + "; ".join(pieces))
    return lines


def _mode_dictionaries(active):
    return {name: dict(getattr(active, name, {})) for name in MODE_DICTIONARY_NAMES}


def _save_mode_dictionaries(config_path, values):
    backup = update_config_assignments(
        config_path, {name: values[name] for name in MODE_DICTIONARY_NAMES}
    )
    reloaded = _mode_dictionaries(load_config(config_path))
    if reloaded != values:
        raise RuntimeError(
            "The mode-specific settings were written but did not reload exactly; "
            "do not run a5 until config.py is inspected."
        )
    print(f"Saved mode-specific settings in {Path(config_path).resolve()}")
    print("Verified: the saved per-mode settings reload correctly.")
    print(f"Backup: {backup}")


def configure_mode_settings(config_path, input_function=input):
    """Interactive editor for the scan and fit dictionaries already used by a1/a5."""
    while True:
        active = load_config(config_path)
        print("\nMode-specific scan and fit settings")
        print("  1. Set geometry Q limits for one or more modes")
        print("  2. Use a polynomial degree for one or more modes")
        print("  3. Use PCHIP for one or more modes")
        print("  4. Set a fitting-only Q interval for one or more modes")
        print("  5. Set or disable the cubic-term restriction by mode")
        print("  6. Remove geometry-limit overrides from selected modes")
        print("  7. Restore global fit defaults for selected modes")
        print("     (removes overrides; it does not disable the global cubic limit)")
        print("  8. Restore all global defaults for selected modes")
        print("  9. Show mode-specific settings")
        print("  0. Back")
        answer = input_function("Select option: ").strip()
        if answer in {"", "0"}:
            return
        if answer == "9":
            print("\n" + "\n".join(mode_specific_lines(active)))
            continue
        if answer not in {"1", "2", "3", "4", "5", "6", "7", "8"}:
            print("Invalid option.")
            continue

        modes = ask_explicit_modes(input_function=input_function)
        values = _mode_dictionaries(active)
        if answer == "1":
            current = list(getattr(active, "Q_ENERGY_ANG", [-0.4, 0.4]))
            current_step = current[1] - current[0] if len(current) > 1 else 0.1
            while True:
                q_min = ask_number("Q minimum (angstrom)", current[0], float,
                                   input_function=input_function)
                q_max = ask_number("Q maximum (angstrom)", current[-1], float,
                                   input_function=input_function)
                step = ask_number("Q step (angstrom)", current_step, float, 1.0e-12,
                                  input_function)
                try:
                    q_min, q_max, step = validate_q_grid(q_min, q_max, step)
                    break
                except ValueError as exc:
                    print(exc)
            count = int(round((q_max - q_min) / step))
            grid = [round(q_min + index * step, 12) for index in range(count + 1)]
            for mode in modes:
                values["Q_ENERGY_ANG_BY_MODE"][mode] = grid
        elif answer == "2":
            while True:
                degree = ask_number("Polynomial degree (2-6)", getattr(active, "FIT_DEGREE", 4),
                                    int, 2, input_function)
                if degree <= 6:
                    break
                print("The current fitter supports degrees from 2 through 6.")
            for mode in modes:
                values["FIT_MODEL_BY_MODE"][mode] = "polynomial"
                values["FIT_DEGREE_BY_MODE"][mode] = degree
        elif answer == "3":
            for mode in modes:
                values["FIT_MODEL_BY_MODE"][mode] = "pchip"
                values["FIT_DEGREE_BY_MODE"].pop(mode, None)
        elif answer == "4":
            while True:
                q_min = ask_number("Fit Q minimum (angstrom)", -0.4, float,
                                   input_function=input_function)
                q_max = ask_number("Fit Q maximum (angstrom)", 0.4, float,
                                   input_function=input_function)
                if math.isfinite(q_min) and math.isfinite(q_max) and q_max > q_min:
                    break
                print("Fit Q maximum must exceed the minimum.")
            for mode in modes:
                values["FIT_Q_RANGE_ANG_BY_MODE"][mode] = (float(q_min), float(q_max))
        elif answer == "5":
            default_factor = getattr(active, "FIT_MAX_CUBIC_FACTOR", 10.0)
            while True:
                raw = ask_text(
                    "Cubic-limit factor (positive number, or none to disable)",
                    "none" if default_factor is None else default_factor,
                    input_function,
                ).strip().lower()
                if raw in {"none", "off", "disable", "disabled"}:
                    cubic_factor = None
                    break
                try:
                    cubic_factor = float(raw)
                except ValueError:
                    cubic_factor = -1.0
                if math.isfinite(cubic_factor) and cubic_factor > 0.0:
                    break
                print("Enter a positive finite factor, or none.")
            for mode in modes:
                values["FIT_MAX_CUBIC_FACTOR_BY_MODE"][mode] = cubic_factor
        elif answer == "6":
            for mode in modes:
                values["Q_ENERGY_ANG_BY_MODE"].pop(mode, None)
        elif answer == "7":
            for name in MODE_DICTIONARY_NAMES:
                if name != "Q_ENERGY_ANG_BY_MODE":
                    for mode in modes:
                        values[name].pop(mode, None)
            default_cubic = getattr(active, "FIT_MAX_CUBIC_FACTOR", None)
            print(
                "Cubic limit after restoring defaults: "
                + ("disabled" if default_cubic is None else f"global factor {float(default_cubic):g}")
                + ". Use option 5 and enter none for an explicit per-mode disable."
            )
        elif answer == "8":
            for name in MODE_DICTIONARY_NAMES:
                for mode in modes:
                    values[name].pop(mode, None)
            default_cubic = getattr(active, "FIT_MAX_CUBIC_FACTOR", None)
            print(
                "All overrides removed. Effective cubic limit: "
                + ("disabled" if default_cubic is None else f"global factor {float(default_cubic):g}")
                + "."
            )
        _save_mode_dictionaries(config_path, values)


